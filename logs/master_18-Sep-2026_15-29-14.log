 25.     foreach con in 2 3 {
 26.         local k = colnumb(R, "`con'.treat_effect_3")
 27.         if `k' == . local k `=`con''
 28.         local b  = R[1,`k']
 29.         local se = R[2,`k']
 30.         local p  = R[4,`k']
 31.         local clab = cond(`con'==2, "negative vs no-frame", "positive vs no-frame")
 32.         preserve
 33.         use `contrasts_fig3', clear
 34.         local newobs = _N + 1
