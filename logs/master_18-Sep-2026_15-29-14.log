file output/tables/SI_heterogeneity_priors.xlsx saved

. putexcel B3 = "Prior moderator"
file output/tables/SI_heterogeneity_priors.xlsx saved

. putexcel C3 = "Moderator value"
file output/tables/SI_heterogeneity_priors.xlsx saved

. putexcel D3 = "Treatment arm"
file output/tables/SI_heterogeneity_priors.xlsx saved

. putexcel E3 = "AME"
file output/tables/SI_heterogeneity_priors.xlsx saved

. putexcel F3 = "SE"
file output/tables/SI_heterogeneity_priors.xlsx saved

. putexcel G3 = "95% CI lower"
file output/tables/SI_heterogeneity_priors.xlsx saved

. putexcel H3 = "95% CI upper"
file output/tables/SI_heterogeneity_priors.xlsx saved

. putexcel I3 = "n"
file output/tables/SI_heterogeneity_priors.xlsx saved

. local row = 4

. 
. foreach y in vol gov busi {
  2.     foreach p of local priors {
  3.         quietly regress state_`y'_t_effect b1.treat_effect_3##c.`p' ///
>             if treat_action_state==2
  4.         quietly margins, dydx(treat_effect_3) ///
>             at(`p'=(0 0.25 0.5 0.75 1)) post
  5.         matrix R = r(table)
  6.         // 5 at points × 3 levels = 15 columns. Cols 1-5: level 1 (omitted),
.         // 6-10: level 2 (negative), 11-15: level 3 (positive).
.         local atvals 0 0.25 0.5 0.75 1
  7.         forvalues j = 1/5 {
  8.             local av : word `j' of `atvals'
  9.             // Negative
.             local k = 5 + `j'
 10.             putexcel A`row' = "`y'"
 11.             putexcel B`row' = "`p'"
 12.             putexcel C`row' = (`av')
 13.             putexcel D`row' = "Will not achieve goal vs no-frame"
 14.             putexcel E`row' = (R[1,`k'])
 15.             putexcel F`row' = (R[2,`k'])
 16.             putexcel G`row' = (R[5,`k'])
 17.             putexcel H`row' = (R[6,`k'])
 18.             putexcel I`row' = (N_`y'_`p')
 19.             local ++row
 20.             // Positive
.             local k = 10 + `j'
 21.             putexcel A`row' = "`y'"
 22.             putexcel B`row' = "`p'"
 23.             putexcel C`row' = (`av')
 24.             putexcel D`row' = "Will achieve goal vs no-frame"
 25.             putexcel E`row' = (R[1,`k'])
 26.             putexcel F`row' = (R[2,`k'])
 27.             putexcel G`row' = (R[5,`k'])
 28.             putexcel H`row' = (R[6,`k'])
 29.             putexcel I`row' = (N_`y'_`p')
 30.             local ++row
 31.         }
 32.     }
 33. }
