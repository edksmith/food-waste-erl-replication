 15.         quietly test 2.treat_effect_3#c.`M' 3.treat_effect_3#c.`M'
 16.         putexcel A`row' = "`M'"
 17.         putexcel B`row' = "`y'"
 18.         putexcel C`row' = "policy support"
 19.         putexcel D`row' = (r(F))
 20.         putexcel E`row' = (r(p))
