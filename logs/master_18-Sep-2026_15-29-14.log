  2.     // Panel A: awareness on perception
.     quietly regress state_`y'_t_info i.treat_action_state
  3.     quietly margins, dydx(treat_action_state) post
  4.     matrix R = r(table)
  5.     local k = colnumb(R, "2.treat_action_state")
  6.     if `k' == . local k 1
  7.     local b  = R[1,`k']
  8.     local se = R[2,`k']
  9.     local p  = R[4,`k']
 10.     preserve
 11.     use `contrasts_fig3', clear
 12.     local newobs = _N + 1
 13.     set obs `newobs'
 14.     replace outcome = "`y'" in `newobs'
 15.     replace contrast = "awareness FW info vs FW no info" in `newobs'
 16.     replace b = `b' in `newobs'
 17.     replace se = `se' in `newobs'
 18.     replace pval = `p' in `newobs'
 19.     replace panel = "A" in `newobs'
 20.     save `contrasts_fig3', replace
 21.     restore
 22. 
.     // Panel B: effectiveness on perception Δ
.     quietly regress state_`y'_t_effect b1.treat_effect_3
