. // ---------- Helper: TOST equivalence test (manual implementation) ----
. // Two one-sided tests using normal approximation.
. // Returns r(tost_p), r(equiv_bound) (smallest |Δ| ruled out at α=.05).
. capture program drop tost_eq

. program define tost_eq, rclass
  1.     syntax , Coef(real) SE(real) SESOI(real)
  2.     local p_lower = 1 - normal((`coef' + `sesoi')/`se')
  3.     local p_upper = 1 - normal((`sesoi' - `coef')/`se')
  4.     local tost_p = max(`p_lower', `p_upper')
  5.     local equiv_bound = abs(`coef') + 1.645*`se'
  6.     return scalar tost_p = `tost_p'
  7.     return scalar equiv_bound = `equiv_bound'
  8. end

. 
. // ---------- Helper: sharpened BKY q-values (Anderson 2008) -----------
. // Input: variable holding p-values; Output: var with sharpened q-values.
. capture program drop bky_qvalues

. program define bky_qvalues
  1.     syntax varname, Generate(name)
  2.     tempvar pvar rank q1 q2 mreject
  3.     qui gen double `pvar' = `varlist'
  4.     qui count if !missing(`pvar')
  5.     local m = r(N)
  6.     sort `pvar'
  7.     qui gen long `rank' = _n if !missing(`pvar')
  8.     // Stage 1: standard BH q-values
.     qui gen double `q1' = `pvar' * `m' / `rank' if !missing(`pvar')
  9.     qui replace `q1' = min(`q1', 1)
 10.     // Enforce monotonicity from bottom
.     forvalues i = `=`m'-1'(-1)1 {
 11.         qui replace `q1' = min(`q1'[`=`i'+1'], `q1'[`i']) in `i'
 12.     }
 13.     // Stage 2: BKY two-stage. Reject set at α/(1+α)≈.0476 with α=.05
.     qui gen byte `mreject' = `q1' <= 0.05/1.05 if !missing(`pvar')
 14.     qui sum `mreject'
 15.     local m0_hat = `m' - r(sum)
 16.     if `m0_hat' < 1 local m0_hat = 1
 17.     // Stage 3: sharpened
.     qui gen double `q2' = `pvar' * `m0_hat' / `rank' if !missing(`pvar')
 18.     qui replace `q2' = min(`q2', 1)
 19.     forvalues i = `=`m'-1'(-1)1 {
 20.         qui replace `q2' = min(`q2'[`=`i'+1'], `q2'[`i']) in `i'
 21.     }
 22.     qui gen double `generate' = `q2'
 23. end

