. local catlab1 "Information & Disclosures"

. local catlab2 "Taxes & Charges"

. local catlab3 "Mandates & Obligations"

. local catlab4 "Continue voluntary action plan"

. local row = 4

. 
. matrix R = R_fig5b

. local cn : colnames R

. foreach c of numlist 1/4 {
  2.     foreach e in 2 3 {
  3.         // mlogit margins, dydx() colnames look like "1.predict:2.treat_effect_3" or
.         // "2#3" — let's search the colnames for tokens matching the pattern.
.         local name1 "`c'._predict:`e'.treat_effect_3"
  4.         local name2 "`e'.treat_effect_3:`c'._predict"
  5.         local k1 : list posof "`name1'" in cn
  6.         local k2 : list posof "`name2'" in cn
  7.         local k = max(`k1', `k2')
  8.         if `k' == 0 continue
  9.         local b  = R[1,`k']
 10.         local se = R[2,`k']
 11.         local t  = R[3,`k']
 12.         local p  = R[4,`k']
 13.         local ll = R[5,`k']
 14.         local ul = R[6,`k']
 15.         tost_eq, coef(`b') se(`se') sesoi(0.02)
 16.         local tp = r(tost_p)
 17.         local eb = r(equiv_bound)
 18.         local clab = cond(`e'==2, "Will not achieve goal vs no-frame", "Will achieve goal vs no-frame")
 19.         putexcel A`row' = "`catlab`c''"
 20.         putexcel B`row' = "`clab'"
 21.         putexcel C`row' = (`b')
 22.         putexcel D`row' = (`se')
 23.         putexcel E`row' = (`t')
 24.         putexcel F`row' = (`p')
 25.         putexcel G`row' = (`ll')
 26.         putexcel H`row' = (`ul')
 27.         putexcel I`row' = (`tp')
 28.         putexcel J`row' = (`eb')
 29.         putexcel K`row' = (N_fig5b)
 30.         local ++row
 31.     }
 32. }

