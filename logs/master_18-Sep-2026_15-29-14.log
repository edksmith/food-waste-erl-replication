. // Joint F-tests for each model
. putexcel set "`xlsx_p'", sheet("joint_F_tests") modify

. putexcel A1 = "SI Figs A4-A6 - Joint interaction F-tests, FW akt=1"
file output/tables/SI_heterogeneity_priors.xlsx saved

. putexcel A3 = "Outcome"
file output/tables/SI_heterogeneity_priors.xlsx saved

. putexcel B3 = "Prior moderator"
file output/tables/SI_heterogeneity_priors.xlsx saved

. putexcel C3 = "F"
file output/tables/SI_heterogeneity_priors.xlsx saved

. putexcel D3 = "p"
file output/tables/SI_heterogeneity_priors.xlsx saved

. putexcel E3 = "n"
file output/tables/SI_heterogeneity_priors.xlsx saved

. local row = 4

. foreach y in vol gov busi {
  2.     foreach p of local priors {
  3.         putexcel A`row' = "`y'"
  4.         putexcel B`row' = "`p'"
  5.         putexcel C`row' = (F_`y'_`p')
  6.         putexcel D`row' = (pF_`y'_`p')
  7.         putexcel E`row' = (N_`y'_`p')
  8.         local ++row
  9.     }
 10. }
