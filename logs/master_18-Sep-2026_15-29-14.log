. // Per-subscale α
. foreach pair in "info 1 2" "tax 3 4" "mandate 5 6 7 8 9 10 11 12" {
  2.     tokenize "`pair'"
  3.     local name `1'
  4.     macro shift
  5.     local idxs `*'
  6.     local items
  7.     foreach k of local idxs {
  8.         local items `items' poms_policy_37_`k'
  9.     }
 10.     quietly alpha `items'
 11.     scalar alpha_`name' = r(alpha)
 12. }

