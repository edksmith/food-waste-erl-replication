. local row = 4

. foreach y in info tax mandate {
  2.     matrix R = R_4g_`y'
  3.     forvalues con = 1/3 {
  4.         local k = colnumb(R, "`con'.treat_effect")
  5.         if `k' == . local k `con'
  6.         local clab : word `con' of "FW_no_frame" "FW_will_not_achieve" "FW_will_achieve"
  7.         putexcel A`row' = "`y'"
  8.         putexcel B`row' = "`clab' vs burden"
  9.         putexcel C`row' = (R[1,`k'])
 10.         putexcel D`row' = (R[2,`k'])
 11.         putexcel E`row' = (R[4,`k'])
 12.         putexcel F`row' = (R[5,`k'])
 13.         putexcel G`row' = (R[6,`k'])
 14.         putexcel H`row' = (N_4g_`y')
 15.         local ++row
 16.     }
 17. }
