. local row = 4

. foreach y in vol gov busi {
  2.     tempvar tmp
  3.     gen `tmp' = state_36_`y' if treat_action_state_3==0
  4.     replace `tmp' = state_31_`y' if treat_action_state_3==1
  5.     quietly ttest `tmp' if treat_action_state_3 < 2, by(treat_action_state_3)
  6.     local m1 = r(mu_1)
  7.     local m2 = r(mu_2)
  8.     local diff = `m2' - `m1'
  9.     local sed  = r(se)
 10.     local t    = r(t)
 11.     local df   = r(df_t)
 12.     local p    = r(p)
 13.     local n1   = r(N_1)
 14.     local n2   = r(N_2)
 15.     tost_eq, coef(`diff') se(`sed') sesoi(0.02)
 16.     local tost_p = r(tost_p)
 17.     local bound  = r(equiv_bound)
 18.     putexcel A`row' = "`y'"
 19.     putexcel B`row' = (`m1')
 20.     putexcel C`row' = (`m2')
 21.     putexcel D`row' = (`diff')
 22.     putexcel E`row' = (`sed')
 23.     putexcel F`row' = (`t')
 24.     putexcel G`row' = (`df')
 25.     putexcel H`row' = (`p')
 26.     putexcel I`row' = (`n1')
 27.     putexcel J`row' = (`n2')
 28.     putexcel K`row' = (`tost_p')
 29.     putexcel L`row' = (`bound')
 30.     local ++row
 31.     drop `tmp'
 32. }
