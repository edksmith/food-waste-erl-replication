 36.         replace outcome = "`y'" in `newobs'
 37.         replace contrast = "`clab'" in `newobs'
 38.         replace b = `b' in `newobs'
 39.         replace se = `se' in `newobs'
 40.         replace pval = `p' in `newobs'
 41.         replace panel = "B" in `newobs'
 42.         save `contrasts_fig3', replace
 43.         restore
 44.     }
 45. }
