. // =====================================================================
. // (3) Predictors of baseline preferences (existing coefplot lifted)
. // =====================================================================
. preserve

. foreach x of varlist income env_att ins_trust poli_ori {
  2.     quietly sum `x'
  3.     local max_`x' = r(max)
  4.     local min_`x' = r(min)
  5.     gen `x'_poms = (`x' - `min_`x'')/(`max_`x'' - `min_`x'')
  6. }
