. // ---------- Summarise per figure ----------
. foreach figno in 3 4 {
  2.     preserve
  3.     use `contrasts_fig`figno'', clear
  4.     bky_qvalues pval, generate(qval)
  5.     gen double tost_p = .
  6.     gen double bound = .
  7.     forvalues i = 1/`=_N' {
  8.         tost_eq, coef(`=b[`i']') se(`=se[`i']') sesoi(0.02)
  9.         qui replace tost_p = r(tost_p) in `i'
 10.         qui replace bound  = r(equiv_bound) in `i'
 11.     }
 12.     gen byte sig_p   = pval < 0.05
 13.     gen byte sig_q   = qval < 0.05
 14.     gen byte equiv   = bound < 0.02
 15.     gen str20 verdict = ""
 16.     replace verdict = "significant"    if sig_p == 1
 17.     replace verdict = "equivalent"     if sig_p == 0 & equiv == 1
 18.     replace verdict = "inconclusive"   if sig_p == 0 & equiv == 0
 19. 
.     di as txt _n _n "=== Fig `figno' contrasts ==="
 20.     list panel outcome contrast b se pval qval bound verdict, ///
>         sepby(panel) noobs abbrev(20) divider
 21. 
.     file write `fh' _n "=== Fig `figno' ===" _n
 22.     file write `fh' _col(1) "panel" _col(8) "outcome" _col(20) "contrast" ///
>         _col(50) "b" _col(60) "p" _col(70) "q(BKY)" _col(82) "bound" _col(94) "verdict" _n
 23.     forvalues i = 1/`=_N' {
 24.         file write `fh' _col(1) (panel[`i']) ///
>             _col(8) (outcome[`i']) ///
>             _col(20) (contrast[`i']) ///
>             _col(50) %8.4f (b[`i']) ///
>             _col(60) %8.4f (pval[`i']) ///
>             _col(70) %8.4f (qval[`i']) ///
>             _col(82) %8.4f (bound[`i']) ///
>             _col(94) (verdict[`i']) _n
 25.     }
 26.     restore
 27. }
